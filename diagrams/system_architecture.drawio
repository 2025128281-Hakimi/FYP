<mxfile host="app.diagrams.net"><diagram name="System Architecture" id="arch"><mxGraphModel dx="1330" dy="870" grid="1" gridSize="10" guides="1" page="1" pageWidth="1330" pageHeight="870"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="user" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#2BA3DD;strokeColor=#2BA3DD;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="70" width="36" height="96" as="geometry"/></mxCell><mxCell id="view" value="&lt;b&gt;VIEW - Web Interface (HTML, CSS, JavaScript in Chrome)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#3B6FD6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontColor=#3B6FD6;" vertex="1" parent="1"><mxGeometry x="240" y="20" width="760" height="180" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Analysis Page&lt;/b&gt;&lt;br&gt;- Records the presentation (microphone)&lt;br&gt;- Live pitch &amp;amp; pauses (Web Audio API)&lt;br&gt;- Live speech rate &amp;amp; filler words&lt;br&gt;&amp;nbsp;&amp;nbsp;(Web Speech API)&lt;br&gt;- Live tips (rule-based, last 30 s)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;verticalAlign=top;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="255" y="55" width="305" height="130" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Results Page&lt;/b&gt;&lt;br&gt;- Overall score &amp;amp; rating&lt;br&gt;- Speech rate, pitch,&lt;br&gt;&amp;nbsp;&amp;nbsp;pauses, filler words" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;verticalAlign=top;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="575" y="55" width="195" height="130" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Recommendations Page&lt;/b&gt;&lt;br&gt;- AI-written personalised&lt;br&gt;&amp;nbsp;&amp;nbsp;feedback&lt;br&gt;- Strengths &amp;amp; areas to improve&lt;br&gt;- Download report" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;verticalAlign=top;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="785" y="55" width="200" height="130" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;b&gt;CONTROLLER - Flask Backend (main.py)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#222222&quot; style=&quot;font-size:12px&quot;&gt;POST /api/analyze : receives the recording, runs the models, returns rating &amp;amp; filler count&lt;br&gt;POST /api/recommendations : receives the measurements, returns AI-generated feedback&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#D98200;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontColor=#D98200;" vertex="1" parent="1"><mxGeometry x="240" y="300" width="760" height="95" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;MODEL - Processing &amp;amp; AI Components (Python)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EEF8F1;strokeColor=#2E9E5B;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontColor=#2E9E5B;" vertex="1" parent="1"><mxGeometry x="240" y="470" width="760" height="375" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Audio Conversion&lt;/b&gt;&lt;br&gt;FFmpeg -&amp;gt; 16 kHz&lt;br&gt;mono WAV" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;verticalAlign=top;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="255" y="510" width="150" height="80" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Preprocessing&lt;/b&gt;&lt;br&gt;Noise reduction,&lt;br&gt;silence trimming" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;verticalAlign=top;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="440" y="510" width="160" height="80" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Feature Extraction&lt;/b&gt;&lt;br&gt;40 MFCCs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;verticalAlign=top;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="635" y="510" width="145" height="80" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b style=&quot;font-size:13px&quot;&gt;Conformer Model&lt;/b&gt;&lt;br&gt;Scored in 25-s chunks,&lt;br&gt;averaged&lt;br&gt;Output: Good / Average / Poor" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#2F5FB3;strokeWidth=2;verticalAlign=top;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="815" y="505" width="170" height="95" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b style=&quot;font-size:13px&quot;&gt;Feature Extraction&lt;/b&gt;&lt;br&gt;40-band&lt;br&gt;mel-spectrogram" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;verticalAlign=top;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="635" y="640" width="145" height="80" as="geometry"/></mxCell><mxCell id="m6" value="&lt;b style=&quot;font-size:13px&quot;&gt;Filler Detector CNN&lt;/b&gt;&lt;br&gt;Detects &amp;quot;uh&amp;quot; / &amp;quot;um&amp;quot;&lt;br&gt;Output: filler word count" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#2F5FB3;strokeWidth=2;verticalAlign=top;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="815" y="635" width="170" height="90" as="geometry"/></mxCell><mxCell id="m7" value="&lt;b style=&quot;font-size:13px&quot;&gt;Recommender (recommender.py)&lt;/b&gt;&lt;br&gt;Sends the measurements + scoring rubric&lt;br&gt;to the LLM and checks the JSON reply&lt;br&gt;(no audio is sent)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;verticalAlign=top;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="255" y="745" width="345" height="85" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b style=&quot;font-size:13px&quot;&gt;OpenAI API&lt;/b&gt;&lt;br&gt;External cloud service (GPT)&lt;br&gt;Writes the personalised&lt;br&gt;recommendations" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#777777;strokeWidth=1;verticalAlign=top;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="745" width="240" height="90" as="geometry"/></mxCell><mxCell id="off" value="&lt;b&gt;OFFLINE TRAINING (done once)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=14;fontColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="470" width="240" height="255" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Conformer Training&lt;/b&gt;&lt;br&gt;TED-LIUM talks labelled&lt;br&gt;good / average / poor by rubric&lt;br&gt;(train.py)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;verticalAlign=top;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1075" y="505" width="210" height="85" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Filler CNN Training&lt;/b&gt;&lt;br&gt;PodcastFillers dataset&lt;br&gt;(train_filler.py)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;verticalAlign=top;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1075" y="630" width="210" height="80" as="geometry"/></mxCell><mxC